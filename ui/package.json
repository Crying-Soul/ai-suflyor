{
  "name": "suflyor",
  "version": "0.1.0",
  "description": "Suflyor, a live call prompter: hears mic + system audio, transcribes locally with whisper.cpp, answers with Claude",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/renderer/md.test.ts src/main/calls.test.ts src/main/log.test.ts",
    "core": "cargo build --profile dist --manifest-path ../core/Cargo.toml",
    "start": "npm run build && electron .",
    "dist": "npm run core && node scripts/build.mjs --dist && electron-builder --win nsis"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "local.suflyor",
    "productName": "Suflyor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../core/target/dist/suflyor-core.exe",
        "to": "suflyor-core.exe"
      },
      {
        "from": "../models/silero_vad.onnx",
        "to": "models/silero_vad.onnx"
      },
      {
        "from": "../whisper",
        "to": "whisper",
        "filter": [
          "whisper.dll",
          "ggml.dll",
          "ggml-base.dll",
          "ggml-cpu-*.dll"
        ]
      },
      {
        "from": "C:/Windows/System32/vcruntime140.dll",
        "to": "vcruntime140.dll"
      },
      {
        "from": "C:/Windows/System32/vcruntime140_1.dll",
        "to": "vcruntime140_1.dll"
      },
      {
        "from": "C:/Windows/System32/msvcp140.dll",
        "to": "msvcp140.dll"
      },
      {
        "from": "C:/Windows/System32/msvcp140_1.dll",
        "to": "msvcp140_1.dll"
      },
      {
        "from": "C:/Windows/System32/vcomp140.dll",
        "to": "whisper/vcomp140.dll"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "electronLanguages": [
      "ru",
      "en-US"
    ],
    "compression": "maximum"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
