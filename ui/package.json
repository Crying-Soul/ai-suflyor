{
  "name": "suflyor",
  "version": "0.1.0",
  "description": "Suflyor, a live call prompter: hears mic + system audio, transcribes locally with whisper.cpp, answers with Claude",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/renderer/md.test.ts src/main/calls.test.ts src/main/log.test.ts",
    "core": "cargo build --release --manifest-path ../core/Cargo.toml",
    "start": "npm run build && electron .",
    "dist": "npm run core && npm run build && electron-builder --win nsis"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "local.suflyor",
    "productName": "Suflyor",
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../core/target/release/suflyor-core.exe",
        "to": "suflyor-core.exe"
      },
      {
        "from": "../whisper",
        "to": "whisper",
        "filter": [
          "*.dll",
          "*.exe"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
